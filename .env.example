# =============================================================================
# Nightfall - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# MySQL connection string. Server refuses most writes without it.
DATABASE_URL=mysql://user:password@localhost:3306/nightfall

# --- Auth / session (required) ----------------------------------------------
# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
COOKIE_SECRET=

# --- Scheduler (in-process cron for deadline nudges + page watches) ----------
# Shared secret required by POST /api/scheduled/* endpoints.
CRON_SECRET=

# --- AI (required for consultant / essay / briefings / reply classification) -
# Without a key, invokeLLM returns mock JSON so the app still boots.
GEMINI_API_KEY=

# --- Gmail integration (required only for university email send/sync) -------
# From Google Cloud Console -> OAuth client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 32+ character secret used to encrypt stored refresh tokens at rest.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Public URL of this deployment, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# --- Storage -----------------------------------------------------------------
# Uploads are stored on local disk under this directory and served at /files/.
DATA_DIR=./data/uploads

# --- Runtime -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# =============================================================================
# After filling this in:
#   pnpm run db:push                                # create tables
#   npx tsx scripts/ingest-programme-directories.ts # load DE v4 + IT v1 data
#                                                   # (put the two XLSX files
#                                                   #  in the project root, or
#                                                   #  set GERMANY_DIRECTORY_PATH
#                                                   #  / ITALY_DIRECTORY_PATH)
#   $env:NODE_ENV="development"; npx tsx watch server/_core/index.ts
#
# The FIRST account you register becomes the admin (sees Admin Intake).
# =============================================================================
